# second-brain local environment
# Copied to .env automatically by `pnpm dev` on first run.

# --- Database (local docker-compose Postgres) ---
DATABASE_URL=postgres://brain:brain@localhost:54321/brain

# --- Object store (local MinIO, S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_RAW=second-brain-raw
AWS_ACCESS_KEY_ID=brainlocal
AWS_SECRET_ACCESS_KEY=brainlocal

# --- Job queue (local ElasticMQ, SQS-compatible) ---
SQS_ENDPOINT=http://localhost:9324
SQS_QUEUE_JOBS=brain-jobs

# --- Slack connector (leave unset to disable syncing / ownership DMs locally) ---
# SLACK_BOT_TOKEN=xoxb-…            # from Secrets Manager: second-brain/slack
#                                   # also used by web for POC assign notifications
# SLACK_TEAM_IDS=T09M72KCQEN        # comma-separated workspace IDs to ingest
# SLACK_CHANNEL_ALLOWLIST=          # optional: restrict to channel IDs (dev)
# SLACK_BACKFILL_DAYS=30            # first-sync horizon; full history via replay
# SLACK_SYNC_INTERVAL_MS=3600000
# APP_BASE_URL=http://localhost:3000  # deep links in ownership / digest DMs

# --- LLM (Amazon Bedrock; agents disabled locally without AWS credentials) ---
# Model tiers and per-agent daily budget caps live in config/llm.json.
# BEDROCK_REGION=us-east-1          # defaults to AWS_REGION, then us-east-1
# LLM_CONFIG_PATH=                  # override config/llm.json location
# LLM_BUDGET_RETRY_DELAY_S=900      # re-queue delay when a budget cap is hit (max 900)
# LLM_REQUEST_TIMEOUT_MS=480000     # abort hung Bedrock Converse calls (default 8m)

# --- Google Workspace connector (blank disables the Secrets Manager lookup locally) ---
GWS_SECRET_ID=
# GWS_SECRET_JSON={"service_account_key":{...},"subject":"...","watched_folder_id":"..."}
# GWS_DOMAIN=example.org            # Workspace domain for directory/people sync

# --- Org wiring ---
# GITLAB_ROOT_GROUP=yourgroup       # root GitLab group for seeding + Jira path matching
# L1_GROUP_EMAIL=                   # Google Group granting the L1 role (empty = ROLE_DEFAULT for all)

# --- Web ---
PORT=3000
